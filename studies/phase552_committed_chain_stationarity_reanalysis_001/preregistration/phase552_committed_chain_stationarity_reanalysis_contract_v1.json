  "flatSectorProjection": {
    "basisSource": "rebuilt from the mesh by the same deterministic construction rule the audited census used, not read from its output",
    "dimensionMustAgreeWithPhase550": true,
    "series": ["flatSectorNormSquared", "complementNormSquared"],
    "rule": "flatSectorNormSquared is the squared norm of the orthogonal projection of the retained position onto the measured flat basis; complementNormSquared is the remainder"
  },

  "driftTest": {
    "frozenBeforeReplay": true,
    "batchCount": 20,
    "batchSizeRule": "retainedPerChain / batchCount, which is 17 at the frozen 340 retained draws",
    "statistics": [
      "half-window difference of batch means, standardized by the batch-mean standard errors of the two halves",
      "ordinary least squares slope of the batch means against the batch index, standardized by its residual standard error"
    ],
    "absoluteZThreshold": 3.0,
    "chainsRequiredToDeclareDrift": 3,
    "decisionSeries": ["configurationNormSquared", "flatSectorNormSquared", "complementNormSquared"],
    "reportedButNotGatedSeries": ["actionDensity", "forceNormSquared"],
    "inconclusiveRule": "any non-finite standardized statistic makes the test inconclusive"
  },

  "convergenceRecomputation": {
    "estimator": "split rank-normalized R-hat with folded rank normalization, plus bulk and tail effective sample size",
    "appliedTo": ["actionDensity", "forceNormSquared", "configurationNormSquared", "flatSectorNormSquared", "complementNormSquared"],
    "rehabilitatesAnyPhase548Gate": false,
    "selectsAnyConfiguration": false
  },

