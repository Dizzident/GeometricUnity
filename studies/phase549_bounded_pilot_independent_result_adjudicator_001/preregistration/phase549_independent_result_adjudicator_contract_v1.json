  "estimatorKnownAnswerBattery": {
    "purpose": "Phase548's tail effective-sample-size estimator was defective and reported non-computable for well-mixed sequences. This adjudicator re-implements the estimators independently and tests them against sequences with known answers BEFORE using them on the pilot draws.",
    "syntheticSeed": 549001,
    "chains": 4,
    "drawsPerChain": 2000,
    "cases": [
      {"id":"independent-draws","kind":"iid","expectRhatBelow":1.01,"expectBulkEssFractionAbove":0.7,"expectTailEssFractionAbove":0.5},
      {"id":"strong-autocorrelation","kind":"ar1","rho":0.9,"expectRhatBelow":1.05,"expectBulkEssFractionBelow":0.15},
      {"id":"separated-chain-means","kind":"iid-with-offset","offset":1.0,"expectRhatAbove":1.01}
    ]
  },

  "telemetryAudit": {
    "requiredTrajectoryFields": ["chainId","trajectoryIndex","phase","accepted","initialHamiltonian","proposedHamiltonian","deltaH","acceptanceProbability","injectedThreshold","nonFinite","divergent","divergenceThreshold","forceEvaluationCount","maximumForceNorm","proposalElapsedCpuTicks"],
    "expectedRowsPerChain": 400,
    "expectedWarmupRows": 60,
    "expectedRetainedRows": 340,
    "acceptanceRuleMustHold": "accepted == (finite and not divergent and injectedThreshold <= min(0, -deltaH))",
    "deltaHConsistencyRule": "deltaH == proposedHamiltonian - initialHamiltonian",
    "requireZeroNonFinite": true,
    "requireZeroDivergent": true,
    "hamiltonianAbsoluteTolerance": 1e-09
  },

  "independentReplay": {
    "reimplementSamplerFromContractAlone": true,
    "compareAgainstTelemetry": true,
    "deltaHRelativeTolerance": 1e-09,
    "acceptanceDecisionsMustMatchExactly": true,
    "recomputeObservablesFromReplay": true,
    "note": "The per-draw observable series was not retained by Phase548, so the reported convergence numbers cannot be recomputed from preserved bytes alone. This adjudicator therefore replays the chains from the frozen seeds with an independent implementation and re-derives the observables itself."
  },

  "reportedDiagnosticsComparison": {
    "rhatAbsoluteTolerance": 1e-06,
    "essRelativeTolerance": 1e-06,
    "mustReproduceEveryReportedGateOutcome": true,
    "mustReproduceReportedTerminal": true
  },

  "checkpointAudit": {
    "recomputePayloadChecksum": true,
    "requireCanonicalPayload": true,
    "requireFinalPositionMatchesReplay": true,
    "positionMustBeBitIdentical": true
  },

  "terminalTaxonomyInPrecedenceOrder": [
